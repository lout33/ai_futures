      "asl_levels": {
        "ASL-1": {
          "description": "No significant uplift over existing tools",
          "current_models": "Pre-Claude",
          "safeguards": "Standard deployment practices"
        },
        "ASL-2": {
          "description": "Models with some uplift but below weapons/cyber thresholds",
