          "safeguards": ["Red teaming", "Usage policies", "Monitoring"],
          "status": "Current operational level"
        },
        "ASL-3": {
          "description": "Significantly increases risk from non-state actors for CBRN or cyber",
          "threshold": "Model provides meaningful uplift for creating biological or cyber weapons",
          "safeguards_required": ["Enhanced security", "Deployment restrictions", "Extensive evals"],
          "status": "Not yet triggered as of Dec 2025"
        },
        "ASL-4": {
          "description": "Could contribute to catastrophic harm if misused or misaligned",
          "threshold": "Model can autonomously accomplish complex malicious tasks",
          "safeguards_required": ["Formal verification", "Interpretability", "Unprecedented security"],
          "status": "Future threshold"
        },
        "ASL-5": {
          "description": "ASI-level capabilities, transformative societal impact",
          "threshold": "Exceeds human experts across virtually all domains",
          "safeguards_required": "Undefined - would require new governance paradigms",
          "status": "Speculative"
        }
      },
      "key_commitments": [
        "Pre-commit to safeguards before reaching next ASL",
